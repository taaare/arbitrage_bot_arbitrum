{
  "name": "simple-arbitrage-arbitrum",
  "version": "0.0.1",
  "description": "Simple WETH arbitrage bot for Uniswap-style markets on Arbitrum",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "start": "ts-node --project tsconfig.json src/index.ts",
    "test": "ts-node node_modules/jasmine/bin/jasmine --config=jasmine.json",
    "build": "tsc",
    "prepare": "npm run build",
    "lint": "eslint src",
    "compile": "hardhat compile",
    "deploy:flash-query": "hardhat run scripts/deploy-flash-query.js --network arbitrum",
    "deploy:executor": "hardhat run scripts/deploy-bundle-executor.js --network arbitrum"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.0",
    "@nomiclabs/hardhat-etherscan": "^3.1.1",
    "@nomiclabs/hardhat-waffle": "^2.0.3",
    "@types/jasmine": "^3.6.2",
    "@types/lodash": "^4.14.165",
    "@types/node": "^14.14.10",
    "@typescript-eslint/eslint-plugin": "^4.9.1",
    "@typescript-eslint/parser": "^4.9.1",
    "chai": "^4.3.6",
    "eslint": "^7.15.0",
    "ethereum-waffle": "^3.4.4",
    "ethers": "^5.7.0",
    "jasmine": "^3.6.3",
    "nyc": "^15.1.0"
  },
  "peerDependencies": {
    "ethers": "^5.0.23"
  },
  "dependencies": {
    "@flashbots/ethers-provider-bundle": "^0.3.1",
    "@openzeppelin/contracts": "^4.7.3",
    "dotenv": "^16.0.3",
    "hardhat": "^2.12.0",
    "lodash": "^4.17.21",
    "ts-node": "^9.1.0",
    "typescript": "^4.1.2"
  }
}
